        "C": "{row.unit}",
        "D": "{row.quantity}",
        "E": "{row.price_value}"
      }
    },
    {
      "first_row": 48,
      "last_row": 53,
      "source": "labor",
      "columns": {
        "B": "{row.post}",
        "C": "{row.headcount}",
        "D": "{row.hours}",
        "E": "{row.rate_value}"
      }
    },
    {
      "first_row": 60,
      "last_row": 62,
      "source": "subcontract",
      "columns": {
        "B": "{row.name}",
        "C": "{row.note}",
        "D": "{row.unit}",
