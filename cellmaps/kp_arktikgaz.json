{
  "sheet": "Лист1",
  "cells": {
    "D2": "{org.short_name}\nЮридический адрес: {org.legal_address}\nПочтовый адрес: {org.postal_address}\n{org.email}, {org.website}\nтел. {org.phones}",
    "A4": "Наименование заказчика: {customer.short_name}",
    "A5": "Местоположение объекта: {tender.object_address}",
    "A6": "Условия оплаты: {tender.payment_terms}",
    "A7": "Срок исполнения: {tender.deadline}",
    "A69": "{org.head_position} {org.head_name}",
    "E72": "Дата: {today}г."
